# Base de datos
DATABASE_URL="mysql://USER:PASS@HOST:3306/sportbar"

# Auth JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET="cambia_esto_por_un_secreto_seguro"

# Supabase Realtime
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxx..."

# Tasa fallback si todas las fuentes BCV fallan
DOLLAR_FALLBACK_RATE=40.00

# Cron job — tasa BCV automática
# Generar con: openssl rand -hex 32
CRON_SECRET="cambia_esto_por_token_aleatorio"
