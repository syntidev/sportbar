// CafeBall — Schema DB v1.2
// POS Sport Bar Guaiqueries de Margarita

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── EVENTOS ───────────────────────────────────────────
enum EventType {
  VENUE
  OUTDOOR
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  type        EventType @default(VENUE)
  date        DateTime?
  is_active   Boolean   @default(false)
  description String?
  created_at  DateTime  @default(now())

  venues  Venue[]
  zones   Zone[]
  orders  Order[]

  @@map("events")
}

// ── VENUES ────────────────────────────────────────────
model Venue {
  id              Int       @id @default(autoincrement())
  name            String
  type            VenueType
  capabilities    Json      // string[] — legacy, ver VenueZone
  zona_geografica Json?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  event_id  Int?
  event     Event? @relation(fields: [event_id], references: [id])

  users               User[]
  venueZones          VenueZone[]
  venueUsers          VenueUser[]
  venuePaymentMethods VenuePaymentMethod[]
  orders_destino      Order[]              @relation("OrderVenueDestino")

  @@map("venues")
}

enum VenueType {
  matriz
  quiosco
  cocina
}

// ── ZONAS DEL ESTADIO (dinámicas) ────────────────────
model Zone {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  color      String      @default("#22c55e")
  capacity   Int         @default(0)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())

  event_id    Int?
  event       Event? @relation(fields: [event_id], references: [id])
  seat_prefix String?
  seat_count  Int?

  venueZones VenueZone[]
  orders     Order[]

  @@map("zones")
}

// ── USUARIOS DEL SISTEMA ──────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  code         String   @unique // USR-001, COC-001, BAR-001, ADM-001
  name         String
  lastname     String
  pin          String   // bcrypt hash
  role         Role
  cedula       String?
  telefono     String?
  venue_id     Int?
  venue        Venue?   @relation(fields: [venue_id], references: [id])
  is_active    Boolean  @default(true)
  access_start String?  // "HH:MM"
  access_end   String?  // "HH:MM"
  access_days  Json?    // string[] ej: ["mon","tue","fri"]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  orders            Order[]           @relation("CreatedBy")
  cancellation_logs CancellationLog[]
  venueUsers        VenueUser[]

  @@index([venue_id], map: "users_venue_id_fkey")
  @@map("users")
}

enum Role {
  mesero
  cocina
  bar
  despacho
  validador
  admin
}

// ── PRODUCTOS ─────────────────────────────────────────
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price_usd   Decimal     @db.Decimal(10, 2)
  category    String      // free string — no enum
  badge       String?     // popular | nuevo | promo | recomendado | null
  is_featured Boolean     @default(false)
  image_url   String?
  effect_type String?     // steam | frost | null
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  order_items    OrderItem[]
  inventory_item InventoryItem?

  @@map("products")
}

// ── INVENTARIO ────────────────────────────────────────
model InventoryItem {
  id         Int      @id @default(autoincrement())
  product_id Int      @unique
  quantity   Decimal  @default(0) @db.Decimal(10, 3)
  unit       String   @default("unid") @db.VarChar(20)
  min_stock  Decimal  @default(0) @db.Decimal(10, 3)
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

// ── ORDENES ───────────────────────────────────────────
model Order {
  id              Int            @id @default(autoincrement())
  code            String         @unique // PUB-00001 o LOC-00001
  origin          Origin
  flujo           OriginFlujo?
  kitchen_status  KitchenStatus  @default(NUEVO)
  payment_status  PaymentStatus  @default(PEND)
  payment_method  String?        // Pago Movil, Efectivo, Zelle, etc
  receipt_photo   String?        // path foto comprobante

  // Cliente
  customer_name     String
  customer_lastname String
  customer_id       String?      // cedula

  // Ubicacion (legacy enum + nuevo FK relacional)
  zone         ZoneCode         // legacy — Norte|Sur|VIP|Externa
  seat         String?          // Fila G Asiento 12 o Palco 5
  zone_id      Int?             // FK a zones.id (nuevo modelo relacional)
  zoneLookup   Zone?  @relation(fields: [zone_id], references: [id])

  // Totales
  total_usd   Decimal  @db.Decimal(10, 2)
  rate_used   Decimal  @db.Decimal(10, 4)  // tasa BCV al momento
  total_bs    Decimal  @db.Decimal(12, 2)  // total_usd x rate_used

  // Routing
  venue_assigned   Int?   // legacy
  venue_destino_id Int?   // FK a venues.id — venue al que fue derivada
  venueDestino     Venue? @relation("OrderVenueDestino", fields: [venue_destino_id], references: [id])

  // Trazabilidad
  created_by  Int
  user        User     @relation("CreatedBy", fields: [created_by], references: [id])
  note        String?
  paid_at     DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  seat_ref  String?
  event_id  Int?
  event     Event? @relation(fields: [event_id], references: [id])

  items             OrderItem[]
  logs              OrderLog[]
  validation        PaymentValidation?
  cancellation_logs CancellationLog[]

  @@index([created_by],       map: "orders_created_by_fkey")
  @@index([zone_id])
  @@index([venue_destino_id])
  @@map("orders")
}

enum Origin {
  PUB   // cliente autonomo via QR
  LOC   // mesero toma la orden
}

enum OriginFlujo {
  A
  B
}

enum KitchenStatus {
  NUEVO
  PREP
  LISTO
  ENTREGADO
}

enum PaymentStatus {
  PEND
  PAID
  CREDIT
  CANCELLED
}

// Renombrado de Zone → ZoneCode para liberar nombre al model Zone
enum ZoneCode {
  Norte
  Sur
  VIP
  Externa
}

// ── ITEMS DE ORDEN ────────────────────────────────────
model OrderItem {
  id          Int     @id @default(autoincrement())
  order_id    Int
  product_id  Int
  qty         Int
  price_usd   Decimal @db.Decimal(10, 2)  // snapshot precio al momento
  subtotal    Decimal @db.Decimal(10, 2)

  order       Order   @relation(fields: [order_id], references: [id])
  product     Product @relation(fields: [product_id], references: [id])

  @@index([order_id],    map: "order_items_order_id_fkey")
  @@index([product_id],  map: "order_items_product_id_fkey")
  @@map("order_items")
}

// ── CONTADORES DE TICKETS ─────────────────────────────
model TicketCounter {
  id      Int    @id @default(autoincrement())
  prefix  String @unique  // PUB o LOC
  last    Int    @default(0)

  @@map("ticket_counters")
}

// ── LOG DE CAMBIOS DE ESTADO ──────────────────────────
model OrderLog {
  id         Int      @id @default(autoincrement())
  order_id   Int
  action     String   // CREATED, STATUS_CHANGE, PAYMENT_REGISTERED, etc
  from_state String?
  to_state   String?
  actor_code String   // USR-001, VAL-001, etc
  note       String?
  created_at DateTime @default(now())

  order      Order    @relation(fields: [order_id], references: [id])

  @@index([order_id], map: "order_logs_order_id_fkey")
  @@map("order_logs")
}

// ── VALIDACION DE COMPROBANTES ────────────────────────
model PaymentValidation {
  id           Int      @id @default(autoincrement())
  order_id     Int      @unique
  photo_path   String?
  validated_by String?  // VAL-001
  status       String   @default("PENDING")  // PENDING, VALIDATED, FLAGGED
  note         String?
  validated_at DateTime?
  created_at   DateTime @default(now())

  order        Order    @relation(fields: [order_id], references: [id])

  @@map("payment_validations")
}

// ── TASA DE CAMBIO ────────────────────────────────────
model DollarRate {
  id              Int       @id @default(autoincrement())
  rate            Decimal   @db.Decimal(12, 4)
  source          String    // bcv | parallel | negotiated | manual
  currency_type   String    @default("USD")  // USD | EUR
  is_active       Boolean   @default(true)
  effective_from  DateTime  @default(now())
  effective_until DateTime?
  created_at      DateTime  @default(now())

  @@index([currency_type, is_active, effective_from])
  @@map("dollar_rates")
}

// ── CONFIGURACION DEL NEGOCIO ─────────────────────────
model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("config")
}

// ── MÉTODOS DE PAGO ───────────────────────────────────
model PaymentMethod {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(80)
  type       PayMethodType
  bank_name  String?       @db.VarChar(100)
  is_active  Boolean       @default(true)
  sort_order Int           @default(0)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@map("payment_methods")
}

enum PayMethodType {
  cash
  transfer
  mobile
  biometric
  other
}

// ── TERMINALES / DISPOSITIVOS POS ────────────────────
model Terminal {
  id                Int            @id @default(autoincrement())
  method            TerminalMethod
  bank_name         String         @db.VarChar(100)
  serial            String?        @db.VarChar(50)
  commercial_number String?        @db.VarChar(50)
  is_active         Boolean        @default(true)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  @@map("terminals")
}

enum TerminalMethod {
  pos_debit
  pos_credit
  biopago
}

// ── ANALYTICS ─────────────────────────────────────────
model AnalyticsEvent {
  id          Int      @id @default(autoincrement())
  event_type  String   @db.VarChar(30)  // page_view | qr_scan | order_placed
  zone        String?  @db.VarChar(20)
  device_type String?  @db.VarChar(20)
  created_at  DateTime @default(now())

  @@index([event_type, created_at])
  @@index([created_at])
  @@map("analytics_events")
}

// ── LOG DE ANULACIONES (INMUTABLE) ───────────────────
model CancellationLog {
  id              Int      @id @default(autoincrement())
  order_id        Int
  order_code      String   // snapshot PUB-XXXXX o LOC-XXXXX
  cancelled_by    Int      // user.id
  reason          String   @db.Text
  previous_status String
  created_at      DateTime @default(now())

  order           Order    @relation(fields: [order_id], references: [id])
  user            User     @relation(fields: [cancelled_by], references: [id])

  @@index([order_id],    map: "cancellation_logs_order_id_fkey")
  @@index([cancelled_by], map: "cancellation_logs_cancelled_by_fkey")
  @@map("cancellation_logs")
}

// ── RELACIONES VENUE ──────────────────────────────────

model VenueZone {
  id       Int   @id @default(autoincrement())
  venue_id Int
  zone_id  Int
  venue    Venue @relation(fields: [venue_id], references: [id])
  zone     Zone  @relation(fields: [zone_id], references: [id])

  @@unique([venue_id, zone_id])
  @@index([venue_id])
  @@index([zone_id])
  @@map("venue_zones")
}

model VenueUser {
  id       Int   @id @default(autoincrement())
  venue_id Int
  user_id  Int
  venue    Venue @relation(fields: [venue_id], references: [id])
  user     User  @relation(fields: [user_id], references: [id])

  @@unique([venue_id, user_id])
  @@index([venue_id])
  @@index([user_id])
  @@map("venue_users")
}

model VenuePaymentMethod {
  id        Int     @id @default(autoincrement())
  venue_id  Int
  method    String
  is_active Boolean @default(true)
  venue     Venue   @relation(fields: [venue_id], references: [id])

  @@unique([venue_id, method])
  @@index([venue_id])
  @@map("venue_payment_methods")
}
